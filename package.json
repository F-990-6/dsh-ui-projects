{
  "name": "dsh-ui-projects",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible UI project system for the dsh Web GUI: a UI project registry plus a dynamically rendered Settings > UI section. Ships Liquid Glass as the first UI project (skin).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.ps1",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/verify.mjs",
    "test:host": "node scripts/host-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
